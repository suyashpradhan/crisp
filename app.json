{
  "expo": {
    "name": "Crisp",
    "slug": "crisp",
    "version": "0.0.1",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "crisp",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "web": {
      "bundler": "metro",
      "output": "server"
    },
    "experiments": {
      "typedRoutes": true
    },
    "plugins": [
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false,
          "microphonePermission": "Crisp uses your microphone to capture spoken tasks.",
          "recordAudioAndroid": true
        }
      ],
      "expo-web-browser",
      "expo-asset"
    ]
  }
}

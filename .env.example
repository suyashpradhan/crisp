# Server-only. Do not prefix this value with EXPO_PUBLIC_.
SARVAM_API_KEY=

# Optional public URL for a deployed Expo Router transcription endpoint.
# Leave blank when the app can use its same-origin /api/transcribe route.
EXPO_PUBLIC_TRANSCRIPTION_API_URL=

# Optional cross-device sync. These are publishable Supabase client values, not service-role secrets.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional gap-free voice capture relay. This is a public WebSocket endpoint;
# it authenticates short-lived anonymous Supabase sessions, never Sarvam keys.
# Example: wss://YOUR_PROJECT_REF.functions.supabase.co/voice-stream
EXPO_PUBLIC_VOICE_STREAM_URL=
